# ---------------------------------------------------------------------------
# Tabb environment variables. Copy to `.env` (never commit `.env`).
# ---------------------------------------------------------------------------

# RPC endpoints
ANVIL_RPC_URL=http://127.0.0.1:8545
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com   # chain id 46630
ROBINHOOD_RPC_URL=                    # mainnet RPC (read-only use; mainnet deploys are done manually after audit)

# Deployer key — ONLY for anvil / testnet. Never put a mainnet key here.
# Default below is anvil's well-known account #0 (public, test-only).
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Optional role addresses for testnet deploys (default: deployer)
TABB_OWNER=
TABB_GUARDIAN=
TABB_TREASURY=
TABB_PAYEE_CURATOR=

# Frontend (web/) — public values only
NEXT_PUBLIC_CHAIN_ID=4663             # 4663 = Robinhood mainnet (default), 46630 = testnet, 31337 = anvil
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_ROBINHOOD_RPC_URL=        # required on Vercel once mainnet contracts are deployed
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
